# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Patient data must never enter version control.
#
# Import and export steps produce files full of real names, and `git add -A`
# does not ask whether a file is sensitive. The scripts write outside the repo
# for that reason; these patterns are the second line of defence, for anything
# that lands here by accident.
*-import-review.json
*-review.json
*patients*.csv
*patients*.json
*.vcf
Table_*.csv
/imports/
/exports/
