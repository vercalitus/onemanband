{
  "name": "onemanband",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "dev:3003": "next dev --turbo -p 3003",
    "dev:clean": "npm run clean && next dev --turbo",
    "dev:3003:clean": "npm run clean && next dev --turbo -p 3003",
    "clean:all": "node scripts/clean-all.mjs",
    "dev:fresh": "npm run clean:all && next dev --turbo",
    "dev:3003:fresh": "npm run clean:all && next dev --turbo -p 3003",
    "dev:webpack:fresh": "npm run clean:all && next dev",
    "build": "next build",
    "start": "next start",
    "start:3003": "next start -p 3003",
    "preview": "npm run rebuild && next start",
    "preview:3003": "npm run rebuild && next start -p 3003",
    "lint": "eslint",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "rebuild": "npm run clean && npm run build",
    "deploy": "vercel --yes --scope ilanmmaojzs-projects",
    "deploy:prod": "vercel --prod --yes --scope ilanmmaojzs-projects"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^15.5.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^50.39.0"
  }
}
