# Copy to .env.local. On Vercel: Project → Settings → Environment Variables (same names).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App-layer field encryption (diagnoses/notes). 32 bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# SUMIT bookkeeping. Create the key pair at https://app.sumit.co.il/developers/keys/
# — the private half is shown once, and an unused key is deleted after 120 days.
# Server-only: this key can issue tax documents in the clinic's name.
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
# Leave unset. SUMIT has no sandbox, so every document is filed as a draft
# (no number, no tax event) until this is deliberately set to 1 for go-live.
SUMIT_LIVE_DOCUMENTS=
# Who receives test documents. A draft is still a real API call and SUMIT mails
# the address it is given, so while SUMIT_LIVE_DOCUMENTS is off every document
# goes here instead of to the (mock) patient. Unset = nothing is mailed at all.
BILLING_TEST_EMAIL=

# Twilio — WhatsApp and SMS. Server-only: these send in the clinic's name and
# are billed per message. Use an API key pair (Console -> API keys), not the
# account auth token, so it can be revoked on its own.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Sender, WhatsApp-prefixed. The Twilio sandbox number while developing,
# the clinic's own number once Meta has approved it.
TWILIO_WHATSAPP_FROM=
# Only needed if the SMS fallback lane is switched on.
TWILIO_SMS_FROM=

# Resend — email. Server-only.
RESEND_API_KEY=
# Leave unset until a domain is verified with Resend: their shared sender is
# used instead, and it only delivers to the account owner.
RESEND_FROM=
